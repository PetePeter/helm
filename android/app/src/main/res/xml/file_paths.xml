<?xml version="1.0" encoding="utf-8"?>
<!--
  What the FileProvider may hand to another app.

  The app's own external Download folder — the pre-API-29 landing place for a
  pulled attachment — plus the two cache directories the artifact editor's
  attach half needs: where a camera capture waits to be staged, and the staged
  copies themselves, which a chip tap opens through a grant instead of a raw
  `file://` uri. Nothing else is listed, so a bug in a uri cannot turn into a
  grant over the app's private data.
-->
<paths>
    <external-files-path name="downloads" path="Download/" />
    <cache-path name="artifact-capture" path="artifact-capture/" />
    <cache-path name="artifact-uploads" path="artifact-uploads/" />
</paths>
