<?xml version="1.0" encoding="utf-8"?>
<!--
  THE HELM BOAT — the same paper sailboat with a terminal prompt in the jib
  that build/icon.png uses on desktop. The wheel below is gone: the user looked
  at the tablet and asked for the mark the app is actually known by. This is a
  redraw of that PNG as vectors, not an approximation of it.

  SOURCE GEOMETRY. build/icon.png is 512 and its mark spans x 95..413, y
  168..418. Mapping it onto this canvas: scale 0.18, mark centre (254,293)
  placed at (54,54) — the 108 canvas centre. Every coordinate below is that
  transform applied to a point measured off the PNG, so the two stay comparable.

  SAFE ZONE. The adaptive safe area is the circle of radius 33 about (54,54),
  not the square 21..87 — a wide mark like this boat is limited by the circle,
  not the box. The extreme points are the hull's top corners (29.5 from centre)
  and the wave's right end (30.7); with the widest stroke half-width (1.6)
  added, nothing exceeds 32.3 against a limit of 33. The desktop PNG's wave ran
  flush with the hull's right tip; that end is pulled in ~3 units (x 410 -> 394
  in source space) because out there it would cross the circle and get clipped
  by round masks.

  STROKE WEIGHTS. The PNG's mint outline is 11px/512, which maps to 2.0 here —
  under 1dp at a 48dp launcher, where it turns to mush. Borders are drawn at
  2.6 and the prompt at 2.4: a deliberate ~20-50% thickening for the panel, the
  same tradeoff the old wheel made (6-7 unit strokes "sized for the panel").
  The wave is 3.0 against a measured 2.5 for the same reason.

  COLOURS. Sampled from the PNG: boat fill #F5FBF7, mint outline #E2F4E6,
  prompt/wave green #4FD08B, background #101614. These are NOT the app tokens —
  helm_accent is lime and would make a different mark; the icon's palette comes
  from the desktop artwork. The background layer stays @color/helm_black
  (true black): #101614 vs #000000 is indistinguishable on a launcher tile and
  the app is true black everywhere else.

  Vector only. minSdk is 26, so the adaptive icon is the ONLY icon that has to
  exist and nothing binary belongs in the tree.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Mainsail: apex, hull top-left, mast base. -->
    <path
        android:fillColor="#F5FBF7"
        android:strokeColor="#E2F4E6"
        android:strokeWidth="2.6"
        android:strokeLineJoin="round"
        android:pathData="M51.5,30.5 L24.9,59 L51.5,59 Z" />

    <!-- Jib: same apex, out to the tip, then the bottom edge that leaves the
         dark slit between sail and hull before meeting the mast base. -->
    <path
        android:fillColor="#F5FBF7"
        android:strokeColor="#E2F4E6"
        android:strokeWidth="2.6"
        android:strokeLineJoin="round"
        android:pathData="M51.5,30.5 L75.9,54.6 L61.5,59 L51.5,59 Z" />

    <!-- Hull: a wide trapezoid, drawn last so its mint top border crosses the
         sail bottoms exactly as it does in the PNG. -->
    <path
        android:fillColor="#F5FBF7"
        android:strokeColor="#E2F4E6"
        android:strokeWidth="2.6"
        android:strokeLineJoin="round"
        android:pathData="M24.9,59 L83.1,59 L74.3,70.1 L34.8,70.1 Z" />

    <!-- The terminal prompt, in the jib. -->
    <path
        android:strokeColor="#4FD08B"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M56.9,42.5 L56.9,53.8" />
    <path
        android:strokeColor="#4FD08B"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M60.3,44.8 L66.6,48.4 L60.3,51.9" />

    <!-- The wave, one smooth line under the hull. -->
    <path
        android:strokeColor="#4FD08B"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M36.3,71.6 C38.5,70 41,68.8 43.9,68.8 C51,68.8 54,75.9 60.3,75.9 C66,75.9 69,68.8 75.1,68.8 C77.5,68.8 78.5,70.2 79.2,71.6" />
</vector>
