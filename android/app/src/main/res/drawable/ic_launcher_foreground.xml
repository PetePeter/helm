<?xml version="1.0" encoding="utf-8"?>
<!--
  A SHIP'S HELM — the wheel you steer with. The app is named for it and the
  whole product is the metaphor: you steer sessions. The previous mark was a
  letter H, a placeholder that was never the real mark.

  GEOMETRY, and why each number is what it is. The canvas is 108 and the
  adaptive-icon safe zone is the middle 66 (x/y 21..87, so radius 33 about the
  centre at 54,54). Everything outside that can be cut, and WHICH part gets cut
  depends on the launcher's mask — circle, squircle, rounded square. So:

  - Handles reach radius 27 and are stroked 6 wide with round caps, which adds
    3 more: extent 84 against a limit of 87. The handles are the part most at
    risk of clipping, so they stop three units short deliberately rather than
    being pushed to the edge to look bigger.
  - The rim sits at radius 18 stroked 7 wide (outer edge 21.5), so the spokes
    project a clear 5+ units past it. That outward silhouette is the whole
    difference between reading as a HELM and reading as a gear or a plain
    circle — without it the mark is just a wheel with a hole.
  - Strokes are 6-7 units on a 108 canvas, which is ~3dp once a launcher draws
    this at 48dp. Hairlines look crisp in a vector viewer and turn to mush on
    a panel; this is sized for the panel.

  The mark spans 60 of the 66 safe units, so it fills the zone rather than
  floating in it — which is what was actually wrong with the H, not clipping.

  Vector only. minSdk is 26, so the adaptive icon is the ONLY icon that has to
  exist and nothing binary belongs in the tree.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Spokes, drawn first so the rim and hub sit on top of the crossing. -->
    <path
        android:strokeColor="@color/helm_accent"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M27,54 L81,54" />
    <path
        android:strokeColor="@color/helm_accent"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M54,27 L54,81" />
    <path
        android:strokeColor="@color/helm_accent"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M34.9,34.9 L73.1,73.1" />
    <path
        android:strokeColor="@color/helm_accent"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M73.1,34.9 L34.9,73.1" />

    <!-- The rim. -->
    <path
        android:strokeColor="@color/helm_accent"
        android:strokeWidth="7"
        android:pathData="M36,54 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0" />

    <!-- The hub. -->
    <path
        android:fillColor="@color/helm_accent"
        android:pathData="M48,54 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
</vector>
