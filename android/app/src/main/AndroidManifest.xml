<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The phone is the BLE PERIPHERAL: it advertises and serves a GATT server;
      Helm (Windows) is the central and connects in. See docs/mobile-ble-transport.md
      and context af250949-a1a4-4c0c-a75c-dbf69987d0e1 (the ratified role flip).
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      BLUETOOTH_SCAN is deliberately ABSENT. A pure peripheral never scans — it
      advertises and waits for Helm to connect. Add it only if a real scan is
      introduced; requesting it unused costs the user a permission prompt for
      nothing and, because it is a location-adjacent permission, a worse one.
    -->

    <!-- Pre-12 equivalents. minSdk is 26, so these still matter. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- The link must survive the screen going off: it lives in a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!--
      The peripheral must also survive a REBOOT: without this, the phone stops
      being reachable until someone opens the app. RECEIVE_BOOT_COMPLETED is a
      normal install-time permission — nothing to grant at runtime. BOOT_COMPLETED
      is an explicit exemption to the background foreground-service start ban, and
      connectedDevice is a type it may start.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!--
      Package visibility for the on-device speech recogniser. Without this,
      SpeechRecognizer.isRecognitionAvailable() returns false on API 30+ even
      when a recogniser is installed, and voice input silently never works.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".HelmApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Helm">
        <!--
          windowSoftInputMode="adjustResize", not adjustPan. Edge-to-edge means
          the window never resizes for the keyboard; what adjustResize does
          instead is promise that the IME inset is DISPATCHED to Compose, where
          HelmTheme's safeDrawingPadding lifts the composer above it. Without it
          the system pans the window, the IME inset reads as zero, and the
          keyboard paints over the composer — the bug the on-device audit caught.
          The thread still auto-scrolls; see ChatScreen.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Helm"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The advertiser lives here so it survives screen-off and backgrounding:
          being reachable from the kitchen is the whole point of the app.
          connectedDevice is the sanctioned foreground type for holding a BLE link.
        -->
        <service
            android:name=".ble.HelmLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          Reboots restart the link on their own. exported is required for a
          receiver with an intent filter on API 31+, and safe here: the broadcast
          is a protected system broadcast, so only the system can send it.
        -->
        <!--
          The notification reply box lands here. NOT exported: the PendingIntent
          that reaches it is MUTABLE, because RemoteInput must write the typed
          text into it, so the receiver being unreachable from outside the app is
          what keeps that safe.
        -->
        <receiver
            android:name=".notify.ReplyReceiver"
            android:exported="false" />

        <receiver
            android:name=".ble.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
