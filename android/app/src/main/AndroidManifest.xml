<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The phone is the BLE PERIPHERAL: it advertises and serves a GATT server;
      Helm (Windows) is the central and connects in. See docs/mobile-ble-transport.md
      and context af250949-a1a4-4c0c-a75c-dbf69987d0e1 (the ratified role flip).
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      BLUETOOTH_SCAN is deliberately ABSENT. A pure peripheral never scans — it
      advertises and waits for Helm to connect. Add it only if a real scan is
      introduced; requesting it unused costs the user a permission prompt for
      nothing and, because it is a location-adjacent permission, a worse one.
    -->

    <!-- Pre-12 equivalents. minSdk is 26, so these still matter. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- The link must survive the screen going off: it lives in a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:name=".HelmApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Helm">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Helm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The advertiser lives here so it survives screen-off and backgrounding:
          being reachable from the kitchen is the whole point of the app.
          connectedDevice is the sanctioned foreground type for holding a BLE link.
        -->
        <service
            android:name=".ble.HelmLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
